Bootstrap: docker
From: python:3.12-slim-bookworm

%labels
    org.opencontainers.image.title "NeMo Gym math-code runtime"
    org.opencontainers.image.description "Minimal x86_64 Python runtime for Harbor math-with-code rollouts"
    org.opencontainers.image.architecture "amd64"

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1
    export MKL_NUM_THREADS=1
    export NUMEXPR_NUM_THREADS=1
    export MALLOC_ARENA_MAX=2

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    # Nested Apptainer inside the Pyxis container cannot switch the apt HTTP
    # worker to the _apt group. Keep the package-fetch helper as root during
    # image assembly; the final runtime remains an ordinary read-only SIF.
    printf 'APT::Sandbox::User "root";\n' > /etc/apt/apt.conf.d/99-nested-apptainer
    apt-get update
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        curl \
        libgomp1
    rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/0.11.18/install.sh | sh
    mv /root/.local/bin/uv /usr/local/bin/uv
    if [ -f /root/.local/bin/uvx ]; then
        mv /root/.local/bin/uvx /usr/local/bin/uvx
    fi

    uv pip install --system --no-cache \
        fastapi==0.136.1 \
        uvicorn==0.46.0 \
        pydantic==2.13.4 \
        math-verify==0.8.0 \
        numpy==2.4.4 \
        scipy==1.17.1 \
        pandas==2.3.3

    mkdir -p /app /logs/agent /logs/verifier
    chmod 0777 /app /logs/agent /logs/verifier
    rm -rf /root/.cache/uv /root/.cache/pip

%test
    set -eux
    test "$(uname -m)" = "x86_64"
    test -x /bin/bash
    command -v timeout
    python3 -c 'import fastapi, uvicorn, pydantic, numpy, scipy, pandas; from math_verify import grader; from math_verify.errors import TimeoutException; from math_verify.metric import math_metric; from math_verify.parser import ExprExtractionConfig, LatexExtractionConfig; print("math-code imports ok")'
    test "$(stat -c '%a' /app)" = "777"

%runscript
    exec "$@"
